# Copy this file to .env and fill in your key

# Port the Express server listens on
PORT=3001

# Your free Groq API key: https://console.groq.com/keys
# (no credit card required)
GROQ_API_KEY=gsk_...

# Groq's OpenAI-compatible endpoint — no need to change this
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Default model to use if the client doesn't specify one
DEFAULT_MODEL=llama-3.3-70b-versatile
